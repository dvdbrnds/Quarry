# ─── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/quarry

# ─── Security ────────────────────────────────────────────────
SECRET_KEY=  # generate with: python -c "import secrets; print(secrets.token_hex(32))"

# ─── App ─────────────────────────────────────────────────────
PUBLIC_URL=https://quarry.moravian.edu
STUDENT_URL=https://parking.moravian.edu  # vanity URL for student-facing links (falls back to PUBLIC_URL)
CORS_ORIGINS=["https://quarry.moravian.edu","https://parking.moravian.edu"]
SCHOOL_NAME=Moravian University

# ─── Branding ─────────────────────────────────────────────────
BRAND_NAME=Quarry
BRAND_PRIMARY_COLOR=#1a2744
BRAND_ACCENT_COLOR=#c9a84c
# BRAND_LOGO_PATH=           # set automatically when logo is uploaded via admin UI
# BRAND_FAVICON_PATH=        # set automatically when favicon is uploaded via admin UI

# ─── Stripe ──────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Okta SSO ────────────────────────────────────────────────
OKTA_DOMAIN=moravian.okta.com
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=
OKTA_AUDIENCE=

# ─── Email (SMTP) ────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=parking@moravian.edu
SMTP_PASSWORD=  # Google Workspace app password
SMTP_FROM_ADDRESS=parking@moravian.edu
SMTP_FROM_NAME=Moravian University Parking
SMTP_USE_TLS=true
CITATION_FROM_ADDRESS=parking@moravian.edu

# ─── SMS (Twilio) ────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ─── Push Notifications (APNs) ──────────────────────────────
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_PATH=
APNS_USE_SANDBOX=false

# ─── GL / Oracle ─────────────────────────────────────────────
GL_LEDGER=Moravian Primary Ledger
GL_SOURCE=QUARRY
GL_CATEGORY_REVENUE=Revenue

# ─── Google Maps ─────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=
