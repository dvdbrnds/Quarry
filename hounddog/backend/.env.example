# ─── Database ────────────────────────────────────────────────
QUARRY_DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/quarry

# ─── Security ────────────────────────────────────────────────
QUARRY_SECRET_KEY=  # generate with: python -c "import secrets; print(secrets.token_hex(32))"

# ─── App ─────────────────────────────────────────────────────
QUARRY_PUBLIC_URL=https://quarry.moravian.edu
QUARRY_STUDENT_URL=https://parking.moravian.edu  # vanity URL for student-facing links (falls back to PUBLIC_URL)
QUARRY_CORS_ORIGINS=["https://quarry.moravian.edu","https://parking.moravian.edu"]
QUARRY_SCHOOL_NAME=Moravian University

# ─── Stripe ──────────────────────────────────────────────────
QUARRY_STRIPE_SECRET_KEY=sk_live_...
QUARRY_STRIPE_PUBLISHABLE_KEY=pk_live_...
QUARRY_STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Okta SSO ────────────────────────────────────────────────
QUARRY_OKTA_DOMAIN=moravian.okta.com
QUARRY_OKTA_CLIENT_ID=
QUARRY_OKTA_CLIENT_SECRET=
QUARRY_OKTA_AUDIENCE=

# ─── Email (SMTP) ────────────────────────────────────────────
QUARRY_SMTP_HOST=smtp.gmail.com
QUARRY_SMTP_PORT=587
QUARRY_SMTP_USER=parking@moravian.edu
QUARRY_SMTP_PASSWORD=  # Google Workspace app password
QUARRY_SMTP_FROM_ADDRESS=parking@moravian.edu
QUARRY_SMTP_FROM_NAME=Moravian University Parking
QUARRY_SMTP_USE_TLS=true
QUARRY_CITATION_FROM_ADDRESS=parking@moravian.edu

# ─── SMS (Twilio) ────────────────────────────────────────────
QUARRY_TWILIO_ACCOUNT_SID=
QUARRY_TWILIO_AUTH_TOKEN=
QUARRY_TWILIO_FROM_NUMBER=

# ─── Push Notifications (APNs) ──────────────────────────────
QUARRY_APNS_KEY_ID=
QUARRY_APNS_TEAM_ID=
QUARRY_APNS_KEY_PATH=
QUARRY_APNS_USE_SANDBOX=false

# ─── GL / Oracle ─────────────────────────────────────────────
QUARRY_GL_LEDGER=Moravian Primary Ledger
QUARRY_GL_SOURCE=QUARRY
QUARRY_GL_CATEGORY_REVENUE=Revenue

# ─── Google Maps ─────────────────────────────────────────────
QUARRY_GOOGLE_MAPS_API_KEY=
